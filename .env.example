# fazscanner/.env
#
# The scanner app talks directly to the FAZ main backend — no second Flask
# app. All scanner routes live under /api/gate on the main FAZ server.
#
# Emulator: 10.0.2.2 reaches the host machine.
# Physical phone: use your LAN IP, e.g. http://192.168.1.42:5000/api/gate
# Production: the deployed FAZ API, always HTTPS.

API_BASE_URL=https://www.server.faz.kanchtech.com/api/gate
APP_ENV=production